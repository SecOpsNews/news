<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>SecOpsNews feeds</title>
    <ownerName>thechelsuk</ownerName>
    <docs>https://opml.org/spec2.opml</docs>
  </head>
  <body>
    <outline text="Headlines" title="Headlines">
      <outline type="rss" text="Dark Reading" title="Dark Reading" xmlUrl="http://www.darkreading.com/rss/all.xml"/>
      <outline type="rss" text="The Hacker News" title="The Hacker News" xmlUrl="https://feeds.feedburner.com/TheHackersNews"/>
      <outline type="rss" text="SecurityWeek" title="SecurityWeek" xmlUrl="https://feeds.feedburner.com/securityweek"/>
      <outline type="rss" text="The Register" title="The Register" xmlUrl="https://www.theregister.com/security/headlines.atom"/>
      <outline type="rss" text="The Register" title="The Register" xmlUrl="https://www.theregister.com/software/headlines.atom"/>
      <outline type="rss" text="BleepingComputer" title="BleepingComputer" xmlUrl="https://www.bleepingcomputer.com/feed/"/>
      <outline type="rss" text="IT Governance" title="IT Governance" xmlUrl="https://www.itgovernance.co.uk/blog/feed"/>
    </outline>
    <outline text="Advisories" title="Advisories">
      <outline type="rss" text="CISA" title="CISA" xmlUrl="https://www.cisa.gov/uscert/ncas/alerts.xml"/>
      <outline type="rss" text="Full Disclosure" title="Full Disclosure" xmlUrl="http://seclists.org/rss/fulldisclosure.rss"/>
      <outline type="rss" text="Microsoft MSRC" title="Microsoft MSRC" xmlUrl="http://blogs.technet.com/msrc/rss.xml"/>
      <outline type="rss" text="NCSC guidance" title="NCSC guidance" xmlUrl="https://www.ncsc.gov.uk/feeds/guidance.xml"/>
      <outline type="rss" text="NCSC threat reports" title="NCSC threat reports" xmlUrl="https://www.ncsc.gov.uk/api/1/services/v1/report-rss-feed.xml"/>
      <outline type="rss" text="Microsoft Security" title="Microsoft Security" xmlUrl="http://blogs.technet.com/mmpc/rss.xml"/>
      <outline type="rss" text="Bugtraq" title="Bugtraq" xmlUrl="http://seclists.org/rss/bugtraq.rss"/>
      <outline type="rss" text="NHS Digital" title="NHS Digital" xmlUrl="https://digital.nhs.uk/feed/cyber-alerts-feed.xml"/>
    </outline>
    <outline text="Critical CVEs" title="Critical CVEs">
      <outline type="rss" text="Cloudflare Radar" title="Cloudflare Radar" xmlUrl="https://radar.cloudflare.com/zero-wire/cves/feed?format=atom&amp;severity=critical"/>
    </outline>
    <outline text="Breaches" title="Breaches">
      <outline type="rss" text="DataBreaches.net" title="DataBreaches.net" xmlUrl="https://feeds.feedburner.com/OfficeOfInadequateSecurity"/>
      <outline type="rss" text="Have I Been Pwned" title="Have I Been Pwned" xmlUrl="https://feeds.feedburner.com/HaveIBeenPwnedLatestBreaches"/>
    </outline>
    <outline text="Blogs" title="Blogs">
      <outline type="rss" text="NETRESEC" title="NETRESEC" xmlUrl="http://www.netresec.com/rss.ashx"/>
      <outline type="rss" text="Krebs on Security" title="Krebs on Security" xmlUrl="https://krebsonsecurity.com/feed/"/>
      <outline type="rss" text="Graham Cluley" title="Graham Cluley" xmlUrl="https://grahamcluley.com/feed/"/>
      <outline type="rss" text="Troy Hunt" title="Troy Hunt" xmlUrl="https://feeds.feedburner.com/TroyHunt"/>
      <outline type="rss" text="Scott Helme" title="Scott Helme" xmlUrl="https://scotthelme.co.uk/rss/"/>
      <outline type="rss" text="Cloudflare blog" title="Cloudflare blog" xmlUrl="https://blog.cloudflare.com/rss/"/>
    </outline>
    <outline text="Status pages" title="Status pages">
      <outline type="rss" text="1Password" title="1Password" xmlUrl="https://1password.statuspage.io/history.atom"/>
      <outline type="rss" text="GitHub" title="GitHub" xmlUrl="https://www.githubstatus.com/history.rss"/>
      <outline type="rss" text="Cloudflare" title="Cloudflare" xmlUrl="https://www.cloudflarestatus.com/history.atom"/>
      <outline type="rss" text="Slack" title="Slack" xmlUrl="https://status.slack.com/feed/rss"/>
      <outline type="rss" text="Azure" title="Azure" xmlUrl="https://azurestatusfeed.azurewebsites.net/"/>
      <outline type="rss" text="Google Cloud" title="Google Cloud" xmlUrl="https://status.cloud.google.com/en/feed.atom"/>
      <outline type="rss" text="AWS" title="AWS" xmlUrl="https://status.aws.amazon.com/rss/all.rss"/>
    </outline>
  </body>
</opml>
